# build artifacts
*.zip
__pycache__/
*.pyc

# local agent/session artifacts
.atl/
.tmp-openai-docs-cache/
.npm-cache/
handoff.md
mirador.html

# workspace locale
# (throwaway ledgers from sandboxes/experiments stay ignored...)
QA-LEDGER.json
# ...but THIS repo now measures itself, so its own root ledger is versioned on
# purpose: uscha's readiness gets a history like any project it governs.
!/QA-LEDGER.json
# ...and so are the `uscha top` fixture ledgers: a fixture git cannot see is a test that
# passes locally and is simply absent in CI.
!/uscha-kit/tests/fixtures/uscha-top/*/QA-LEDGER.json
REBUILD-BASELINE.json
.claude/settings.local.json

# statusline: regenerated each Stop hook (like mirador.html)
.claude/uscha-progress.json

# local handoff notes (consumer-specific, never published)
docs/HANDOFF_statusline_uscha-kit.md
detalle.md

# coverage.py parallel-mode data (regenerated by USCHA_COVERAGE=1 smoke runs)
.coverage-data/

# private name list for AC-03 (never published -- see CLAUDE.md)
.uscha-private-names

# Session transcripts dumped at the repo root: they carry local paths, the author's
# email and (historically) the private names AC-03 exists to keep out. Untracked is not
# enough -- one `git add -A` is how those names reached the history the first time.
chat-*.md
*-transcript.md
.claude/launch.json
.fastpath-cases.json
.specdrift-cases.json
.goldencov-cases.json
.origin-cases.json
.cleanroom-cases.json
.curation-cases.json
.oracle-cases.json
.facts-cases.json
.delta-cases.json
.fidelity-cases.json
.ir-cases.json
ir/

# wrangler cache (site dev, regenerated)
.wrangler/

# engine run artifacts when the suite runs from inside the kit (sidecars + junit, regenerated)
uscha-kit/reports/

# approval-testing residue: a green run leaves a .received identical to the golden;
# a red run fails the harness itself, so git status is not the signal
tests/golden/*.received.json

# release ritual state (tools/release.py): X's identity and the suite counts, so a resumed
# run can still catch an amend. Untracked AND ignored on purpose -- an untracked file the
# seal can see would break check-terminado at X+1 (ADR-038).
.uscha-release-state.json
