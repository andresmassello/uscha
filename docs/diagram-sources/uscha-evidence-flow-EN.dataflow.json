  "cards": [
    {
      "dot": "emerald",
      "title": "The main path",
      "items": [
        "A tool writes a file; the engine reads it and records a fact",
        "Every verdict is derived from the ledger, never declared",
        "The merge decision is read, not argued"
      ]
    },
    {
      "dot": "amber",
      "title": "Measured vs narrated",
      "items": [
        "Measured: the engine ran it or parsed the report itself",
        "Narrated: the agent's own counts from log-step",
        "A measured red always overrides a narrated green"
      ]
    },
    {
      "dot": "rose",
      "title": "What the human keeps",
      "items": [
        "Closing an escalation and confirming a deferral are human acts",
        "pr-ready only keeps the PR in draft",
        "The merge itself is never the agent's"
      ]
    }
