  "cards": [
    {
      "dot": "emerald",
      "title": "El camino principal",
      "items": [
        "Una herramienta escribe un archivo; el motor lo lee y registra un hecho",
        "Cada veredicto se deriva del ledger, nunca se declara",
        "La decisión de merge se lee, no se discute"
      ]
    },
    {
      "dot": "amber",
      "title": "Medido vs narrado",
      "items": [
        "Medido: el motor lo corrió o parseó el reporte él mismo",
        "Narrado: los conteos del propio agente en log-step",
        "Un rojo medido siempre anula un verde narrado"
      ]
    },
    {
      "dot": "rose",
      "title": "Lo que conserva el humano",
      "items": [
        "Cerrar una escalación y confirmar un diferimiento son actos humanos",
        "pr-ready solo mantiene el PR en borrador",
        "El merge nunca lo hace el agente"
      ]
    }
