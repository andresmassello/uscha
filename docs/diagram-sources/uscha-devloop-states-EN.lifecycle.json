      "from": "cap",
      "to": "esc",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "label": "round cap",
      "labelAt": [
        750,
        393
      ]
    },
    {
      "from": "lowered",
      "to": "tier",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
    },
    {
      "from": "defer",
      "to": "scope",
      "variant": "security",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
