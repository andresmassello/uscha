      "lane": "terminal",
      "col": 1
    },
    {
      "id": "esc",
      "type": "failure",
      "label": "escalated",
      "sublabel": "blocks pr-ready",
      "tag": "resolve-escalation",
      "lane": "terminal",
      "col": 2
    }
