  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "plan, build, qa, pr-ready: each phase is read from measured facts",
        "qa repeats until every tool of the tier is clean on the tree on disk",
        "A human merges; the agent never does"
      ]
    },
    {
      "dot": "cyan",
      "title": "Review pace",
      "items": [
        "The changed paths set the tier; the tier picks the review tools",
        "The engine assigns each review its scope, never the agent",
        "Fixes are re-reviewed on their diff, not the whole change"
      ]
    },
    {
      "dot": "rose",
      "title": "Stops that need a person",
      "items": [
        "Round cap reached: escalate, do not run another cycle",
        "An open spec-doubt or finding also reads as escalated",
        "Only a human closes an escalation, confirms a deferral or lowers the tier"
      ]
    }
  ]
}