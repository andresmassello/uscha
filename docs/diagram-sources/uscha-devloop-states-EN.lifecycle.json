{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "The life of a change",
    "subtitle": "The phase is derived from the ledger, never declared · the review loop converges or escalates · the human merges"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Phases derived by phase"
    },
    {
      "id": "review",
      "label": "Review pace"
    },
    {
      "id": "terminal",
      "label": "Human-only acts"
    }
  ],
  "states": [
    {
      "id": "plan",
      "type": "start",
      "label": "plan",
      "sublabel": "nothing measured yet",
      "tag": "empty ledger",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "build",
      "type": "active",
      "label": "build",
      "sublabel": "snapshots, no QA yet",
      "tag": "measured",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "qa",
      "type": "active",
      "label": "qa",
      "sublabel": "review loop running",
      "tag": "not converged",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "prready",
      "type": "decision",
      "label": "pr-ready",
      "sublabel": "leaves draft",
      "tag": "derived, not declared",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "merged",
      "type": "success",
      "label": "Merged",
      "sublabel": "the human owns it",
      "tag": "terminal",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "tier",
      "type": "active",
      "label": "Tier by paths",
      "sublabel": "from changed globs",
      "tag": "quick/std/deep",
      "lane": "review",
      "col": 0,
      "width": 104
    },
    {
      "id": "scope",
      "type": "active",
      "label": "Engine scope",
      "sublabel": "whole, then diff",
